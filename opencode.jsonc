{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "duckduckgo": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "duckduckgo-mcp-server"
      ],
      "enabled": true
    },
    "unsplash": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "set -a && source .env && set +a && exec npx -y @jeff_kit/unsplash-mcp-server --response-format text"
      ],
      "enabled": true
    },
    "marp-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@masaki39/marp-mcp@latest"
      ]
    }
  }
}
